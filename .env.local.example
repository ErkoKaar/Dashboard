# FinanceTracker Supabase project
# URL and anon key from the FinanceTracker Supabase project (Project Settings > API).
# Used client-side to read/write expenses and income.
NEXT_PUBLIC_FINANCE_SUPABASE_URL=
NEXT_PUBLIC_FINANCE_SUPABASE_ANON_KEY=

# TaskManager + FocusLoop Supabase project
# URL and anon key from the TaskManager/FocusLoop Supabase project (Project Settings > API).
# Used client-side to read/write tasks and FocusLoop sessions.
NEXT_PUBLIC_TASKS_SUPABASE_URL=
NEXT_PUBLIC_TASKS_SUPABASE_ANON_KEY=

# EstHoop FastAPI backend (Render), e.g. https://esthoop-backend.onrender.com
# Public, read-only — used client-side to fetch national team games
# (GET {url}/national-team/games). The backend's CORS allowlist must include
# this dashboard's origin.
NEXT_PUBLIC_ESTHOOP_API_URL=

# GitHub GraphQL API
# Classic personal access token (not fine-grained) with `read:user` scope,
# plus `repo` scope if you want private repos/contributions included (also
# requires "Include private contributions on my profile" enabled on your
# GitHub account). Server-side only (no NEXT_PUBLIC_ prefix) — used via the
# `viewer` field, so no separate username variable is needed.
GITHUB_TOKEN=

# Chess.com public API (no auth needed — chess.com profiles are public data).
# Used client-side to read rapid rating/trend/record for the Chess widget.
NEXT_PUBLIC_CHESS_USERNAME=

# Google Calendar API. One-time manual OAuth setup (no in-app login flow):
# 1. Google Cloud Console: create/select a project, enable the Calendar API.
# 2. Create an OAuth 2.0 Client ID (type "Web application"), add
#    https://developers.google.com/oauthplayground as an authorized redirect URI.
# 3. Go to https://developers.google.com/oauthplayground, gear icon ->
#    "Use your own OAuth credentials" -> paste the Client ID/Secret from step 2.
# 4. Step 1 in the Playground: select Calendar API v3, scope
#    https://www.googleapis.com/auth/calendar.readonly, authorize.
# 5. Step 2: "Exchange authorization code for tokens" -> copy the refresh_token.
# All three server-side only (no NEXT_PUBLIC_ prefix) — the server mints a
# fresh access token from the refresh token on every request.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Anthropic API — used server-side to generate the daily Summary widget text.
# Server-side only (no NEXT_PUBLIC_ prefix).
ANTHROPIC_API_KEY=

# Spotify Web API. One-time manual OAuth setup (no in-app login flow):
# 1. developer.spotify.com/dashboard -> Create app -> add redirect URI
#    http://127.0.0.1:8888/callback -> enable Web API.
# 2. Copy the Client ID and Client Secret from the app's Settings page.
# 3. Visit (with your own client_id):
#    https://accounts.spotify.com/authorize?client_id=YOUR_CLIENT_ID&response_type=code&redirect_uri=http://127.0.0.1:8888/callback&scope=user-read-currently-playing%20user-top-read%20user-modify-playback-state
#    Approve access; the browser will fail to load the redirect (expected —
#    nothing listens on that port) but the address bar will contain `code=`.
# 4. Exchange that code for a refresh token:
#    curl -X POST https://accounts.spotify.com/api/token \
#      -d grant_type=authorization_code -d code=YOUR_CODE \
#      -d redirect_uri=http://127.0.0.1:8888/callback \
#      -d client_id=YOUR_CLIENT_ID -d client_secret=YOUR_CLIENT_SECRET
# All three server-side only (no NEXT_PUBLIC_ prefix) — the server mints a
# fresh access token from the refresh token on every request. Playback
# control (play/pause/skip) requires an active Spotify Connect device and a
# Premium account.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Finance widgeti lukk: kui väärtus on seatud, küsib dashboardi Finance widget
# enne numbrite näitamist seda parooli. Kontroll käib serveris (/api/finance-pin),
# nii et parool ei satu kliendi bundle'isse. Tühjaks jättes lukku pole.
FINANCE_WIDGET_PIN=
